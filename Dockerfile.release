# Image built by GoReleaser from the release binaries (see .goreleaser.yaml),
# which embed the pinned web app. For local builds use the Dockerfile
# (`make docker`).
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/panelarr /panelarr
COPY --chown=65532:65532 packaging/config /config
COPY --chown=65532:65532 packaging/data /data
ENV PANELARR_LISTEN=:8900 \
    PANELARR_CONFIG=/config \
    PANELARR_DATA=/data
VOLUME ["/config", "/data"]
EXPOSE 8900
USER 65532:65532
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/panelarr", "healthcheck"]
ENTRYPOINT ["/panelarr"]
CMD ["serve"]
